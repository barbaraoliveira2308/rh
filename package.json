{
  "name": "@bridge351/srh",
  "version": "0.1.0",
  "private": true,
  "description": "HR Suite — Sistema de Gestão de Recursos Humanos",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:ci": "pnpm -r run lint:ci",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yml,yaml,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "uuid": "^11.1.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "fast-uri": "^3.1.5"
    }
  }
}
