# ─── Test Database ────────────────────────────────────────
POSTGRES_DB=srh_test
POSTGRES_USER=srh_user
POSTGRES_PASSWORD=srh_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Server ─────────────────────────────────────────────
BACKEND_PORT=3000
BACKEND_CORS_ORIGIN=http://localhost:5173

# ─── Auth (JWT) ─────────────────────────────────────────
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── MFA ────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=change_me_mfa_key_32_bytes

# ─── Storage (MinIO / S3) ───────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET=srh-documents
STORAGE_REGION=eu-west-1
STORAGE_USE_SSL=false

# ─── Redis (cache / queue) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Mail ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@srh.bridge351.com
