# ─── Database ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=srh
POSTGRES_USER=srh_user
POSTGRES_PASSWORD=change_me

# ─── Server ─────────────────────────────────────────────
BACKEND_PORT=3000
BACKEND_CORS_ORIGIN=http://localhost:5173

# ─── Auth (JWT) ─────────────────────────────────────────
# Chaves RSA (PKCS8/SPKI PEM, codificadas em base64) — gerar com scripts/generate-secrets.sh
JWT_ACCESS_PRIVATE_KEY=change_me_run_generate_secrets_sh
JWT_ACCESS_PUBLIC_KEY=change_me_run_generate_secrets_sh
JWT_REFRESH_PRIVATE_KEY=change_me_run_generate_secrets_sh
JWT_REFRESH_PUBLIC_KEY=change_me_run_generate_secrets_sh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── MFA ────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=change_me_mfa_key_32_bytes

# ─── Storage (MinIO / S3) ───────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET=srh-documents
STORAGE_REGION=eu-west-1
STORAGE_USE_SSL=false

# ─── Redis (cache / queue) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Monitoring ─────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ─── Mail ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@srh.bridge351.com
