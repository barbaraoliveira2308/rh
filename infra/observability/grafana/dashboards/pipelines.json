            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir job no GitLab",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "success_with_warnings": {
                        "text": "OK com avisos",
                        "color": "orange",
                        "index": 1
                      },
                      "failed": {
                        "text": "Falhou",
                        "color": "red",
                        "index": 2
                      },
                      "canceled": {
                        "text": "Cancelado",
