                        "index": 3
                      },
                      "skipped": {
                        "text": "Não correu",
                        "color": "gray",
                        "index": 4
                      },
                      "manual": {
                        "text": "Manual",
                        "color": "gray",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duração"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              }
            ]
          }
        ]
      }
    }
  ],
  "links": [
